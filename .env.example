# Azure OpenAI Configuration
# Get these from your Azure OpenAI resource (Azure Portal -> your resource -> "Keys and Endpoint"),
# NOT the Azure AI Foundry project endpoint (they look different and are not interchangeable).
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Must be the bare resource endpoint, e.g. https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# The deployment name you gave your chat model in Azure AI Foundry -> Deployments
# (this can differ from the underlying model name, e.g. "my-gpt-4o")
AZURE_OPENAI_DEPLOYMENT_NAME=your_azure_openai_deployment_name_here

# Used by the webapp to sign session cookies. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_secret_key_here
